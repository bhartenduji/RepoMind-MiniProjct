"""
RepoMind - Binary Classification Dataset Builder

Builds a binary bug-fix classification dataset from:

    Positive:
        data/processed/bug_fix_quality_filtered.jsonl

    Negative:
        data/processed/non_bug_fix_candidates.jsonl

Labels:

    1 = bug-fix / positive
    0 = non-bug-fix / negative

Outputs:

    data/processed/classification_dataset.jsonl
    data/processed/classification_splits/train.jsonl
    data/processed/classification_splits/validation.jsonl
    data/processed/classification_splits/test.jsonl
"""

from __future__ import annotations

import json
import random
from pathlib import Path
from collections import Counter


# ============================================================
# PATHS
# ============================================================

POSITIVE_PATH = Path(
    "data/processed/bug_fix_quality_filtered.jsonl"
)

NEGATIVE_PATH = Path(
    "data/processed/non_bug_fix_candidates.jsonl"
)

OUTPUT_PATH = Path(
    "data/processed/classification_dataset.jsonl"
)

SPLIT_DIR = Path(
    "data/processed/classification_splits"
)

TRAIN_PATH = SPLIT_DIR / "train.jsonl"
VALIDATION_PATH = SPLIT_DIR / "validation.jsonl"
TEST_PATH = SPLIT_DIR / "test.jsonl"


# ============================================================
# CONFIGURATION
# ============================================================

# Number of positive examples to use.
#
# Your quality-filtered positive dataset currently contains:
#
#     12,983 records
#
# We use at most 12,000 so the dataset size is controlled.
MAX_POSITIVES = 12_000

# Use as many negatives as are available, up to the
# number of positive examples.
#
# Your negative dataset currently contains:
#
#     5,827 records
#
# Therefore the final dataset will be approximately:
#
#     12,000 positive
#      5,827 negative
#     ----------------
#     17,827 total
#
# If fewer positives are available, the number of negatives
# is automatically reduced to match.
MAX_NEGATIVES = 12_000


# Dataset split ratios.
TRAIN_RATIO = 0.80
VALIDATION_RATIO = 0.10
TEST_RATIO = 0.10


# Reproducible shuffle.
RANDOM_SEED = 42


# ============================================================
# JSONL HELPERS
# ============================================================

def load_jsonl(path: Path) -> list[dict]:
    """
    Load records from a JSONL file.
    """

    if not path.exists():
        raise FileNotFoundError(
            f"Input file not found: {path}"
        )

    records = []

    with path.open(
        "r",
        encoding="utf-8",
    ) as file:

        for line_number, line in enumerate(
            file,
            start=1,
        ):

            line = line.strip()

            if not line:
                continue

            try:
                record = json.loads(line)
            except json.JSONDecodeError as exc:
                raise ValueError(
                    f"Invalid JSON on line "
                    f"{line_number} in {path}: {exc}"
                ) from exc

            if not isinstance(record, dict):
                raise ValueError(
                    f"Expected JSON object on line "
                    f"{line_number} in {path}"
                )

            records.append(record)

    return records


def write_jsonl(
    path: Path,
    records: list[dict],
) -> None:
    """
    Write records to JSONL.
    """

    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    with path.open(
        "w",
        encoding="utf-8",
    ) as file:

        for record in records:

            file.write(
                json.dumps(
                    record,
                    ensure_ascii=False,
                )
                + "\n"
            )


# ============================================================
# LABEL NORMALIZATION
# ============================================================

def prepare_positive_records(
    records: list[dict],
) -> list[dict]:
    """
    Prepare positive examples.

    Force label = 1 regardless of whether an old label exists.
    """

    prepared = []

    for record in records:

        item = dict(record)

        item["label"] = 1

        prepared.append(item)

    return prepared


def prepare_negative_records(
    records: list[dict],
) -> list[dict]:
    """
    Prepare negative examples.

    Force label = 0 regardless of whether an old label exists.
    """

    prepared = []

    for record in records:

        item = dict(record)

        item["label"] = 0

        prepared.append(item)

    return prepared


# ============================================================
# DUPLICATE HANDLING
# ============================================================

def deduplicate_records(
    records: list[dict],
) -> list[dict]:
    """
    Remove duplicate records using record_id.

    If record_id is missing, keep the record.
    """

    seen = set()
    result = []

    for record in records:

        record_id = record.get("record_id")

        if not record_id:
            result.append(record)
            continue

        if record_id in seen:
            continue

        seen.add(record_id)

        result.append(record)

    return result


# ============================================================
# DATASET BUILDING
# ============================================================

def build_dataset() -> list[dict]:
    """
    Load positive and negative datasets and construct
    the final classification dataset.
    """

    print()
    print("=" * 70)
    print("RepoMind Binary Classification Dataset Builder")
    print("=" * 70)
    print()

    # --------------------------------------------------------
    # Load positive examples
    # --------------------------------------------------------

    print("Loading positive examples...")
    print(
        f"Source: {POSITIVE_PATH}"
    )

    positive_records = load_jsonl(
        POSITIVE_PATH
    )

    print(
        f"Positive records loaded: "
        f"{len(positive_records)}"
    )

    # --------------------------------------------------------
    # Load negative examples
    # --------------------------------------------------------

    print()
    print("Loading negative examples...")
    print(
        f"Source: {NEGATIVE_PATH}"
    )

    negative_records = load_jsonl(
        NEGATIVE_PATH
    )

    print(
        f"Negative records loaded: "
        f"{len(negative_records)}"
    )

    # --------------------------------------------------------
    # Deduplicate
    # --------------------------------------------------------

    positive_records = deduplicate_records(
        positive_records
    )

    negative_records = deduplicate_records(
        negative_records
    )

    print()
    print(
        f"Positive after deduplication: "
        f"{len(positive_records)}"
    )

    print(
        f"Negative after deduplication: "
        f"{len(negative_records)}"
    )

    # --------------------------------------------------------
    # Apply labels
    # --------------------------------------------------------

    positive_records = prepare_positive_records(
        positive_records
    )

    negative_records = prepare_negative_records(
        negative_records
    )

    # --------------------------------------------------------
    # Shuffle independently
    # --------------------------------------------------------

    rng = random.Random(
        RANDOM_SEED
    )

    rng.shuffle(
        positive_records
    )

    rng.shuffle(
        negative_records
    )

    # --------------------------------------------------------
    # Select examples
    # --------------------------------------------------------

    positive_count = min(
        MAX_POSITIVES,
        len(positive_records),
    )

    selected_positive = positive_records[
        :positive_count
    ]

    # Do not pretend the dataset is balanced if there are
    # not enough negatives.
    negative_count = min(
        MAX_NEGATIVES,
        len(negative_records),
        positive_count,
    )

    selected_negative = negative_records[
        :negative_count
    ]

    # --------------------------------------------------------
    # Combine
    # --------------------------------------------------------

    dataset = (
        selected_positive
        +
        selected_negative
    )

    # Final global shuffle.
    rng.shuffle(
        dataset
    )

    # --------------------------------------------------------
    # Statistics
    # --------------------------------------------------------

    labels = Counter(
        record["label"]
        for record in dataset
    )

    repositories = Counter(
        record.get(
            "repo_id",
            "unknown",
        )
        for record in dataset
    )

    print()
    print("=" * 70)
    print("FINAL CLASS DISTRIBUTION")
    print("=" * 70)

    print(
        f"label 0: {labels.get(0, 0)}"
    )

    print(
        f"label 1: {labels.get(1, 0)}"
    )

    print(
        f"Total:   {len(dataset)}"
    )

    print()
    print("Repositories represented:")

    for repo, count in repositories.most_common():
        print(
            f"  {repo}: {count}"
        )

    return dataset


# ============================================================
# DATASET SPLITTING
# ============================================================

def split_dataset(
    records: list[dict],
) -> tuple[
    list[dict],
    list[dict],
    list[dict],
]:
    """
    Split dataset into train / validation / test.

    Approximate ratios:

        train      80%
        validation 10%
        test       10%
    """

    if not records:
        raise ValueError(
            "Cannot split an empty dataset."
        )

    rng = random.Random(
        RANDOM_SEED
    )

    shuffled = list(records)

    rng.shuffle(
        shuffled
    )

    total = len(shuffled)

    train_end = int(
        total * TRAIN_RATIO
    )

    validation_end = (
        train_end
        +
        int(total * VALIDATION_RATIO)
    )

    train = shuffled[
        :train_end
    ]

    validation = shuffled[
        train_end:validation_end
    ]

    test = shuffled[
        validation_end:
    ]

    return (
        train,
        validation,
        test,
    )


# ============================================================
# SPLIT STATISTICS
# ============================================================

def print_split_statistics(
    name: str,
    records: list[dict],
) -> None:
    """
    Print class and repository distribution.
    """

    labels = Counter(
        record["label"]
        for record in records
    )

    repos = Counter(
        record.get(
            "repo_id",
            "unknown",
        )
        for record in records
    )

    print()
    print("=" * 70)
    print(name.upper())
    print("=" * 70)

    print(
        f"Total:      {len(records)}"
    )

    print(
        f"Label 0:    {labels.get(0, 0)}"
    )

    print(
        f"Label 1:    {labels.get(1, 0)}"
    )

    print()
    print("Repositories:")

    for repo, count in repos.most_common():
        print(
            f"  {repo}: {count}"
        )


# ============================================================
# MAIN
# ============================================================

def main() -> None:

    dataset = build_dataset()

    # --------------------------------------------------------
    # Write complete dataset
    # --------------------------------------------------------

    write_jsonl(
        OUTPUT_PATH,
        dataset,
    )

    # --------------------------------------------------------
    # Split
    # --------------------------------------------------------

    train, validation, test = (
        split_dataset(dataset)
    )

    # --------------------------------------------------------
    # Write splits
    # --------------------------------------------------------

    write_jsonl(
        TRAIN_PATH,
        train,
    )

    write_jsonl(
        VALIDATION_PATH,
        validation,
    )

    write_jsonl(
        TEST_PATH,
        test,
    )

    # --------------------------------------------------------
    # Statistics
    # --------------------------------------------------------

    print_split_statistics(
        "Train",
        train,
    )

    print_split_statistics(
        "Validation",
        validation,
    )

    print_split_statistics(
        "Test",
        test,
    )

    # --------------------------------------------------------
    # Final summary
    # --------------------------------------------------------

    print()
    print("=" * 70)
    print("CLASSIFICATION DATASET COMPLETE")
    print("=" * 70)

    print(
        f"Total:      {len(dataset)}"
    )

    print(
        f"Train:      {len(train)}"
    )

    print(
        f"Validation: {len(validation)}"
    )

    print(
        f"Test:       {len(test)}"
    )

    print()
    print(
        f"Output:     {OUTPUT_PATH}"
    )

    print(
        f"Train:      {TRAIN_PATH}"
    )

    print(
        f"Validation: {VALIDATION_PATH}"
    )

    print(
        f"Test:       {TEST_PATH}"
    )

    print()
    print(
        "Dataset construction completed successfully."
    )


if __name__ == "__main__":
    main()